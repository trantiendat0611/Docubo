# Copy to .env, then fill in. Never commit the filled-in file.
#
# One .env serves both halves: the Python ingest reads it via python-dotenv,
# and `next dev` / `next build` load it too. The Gemini provider in
# src/lib/gemini.ts is constructed with an explicit apiKey so that both sides
# share GEMINI_API_KEY — the AI SDK's default provider would otherwise expect
# GOOGLE_GENERATIVE_AI_API_KEY, and two names for one key is a trap.

# --- Gemini (https://aistudio.google.com) ---
GEMINI_API_KEY=
# Pin a named version, not `gemini-flash-latest` — a floating alias makes the
# page cache and the eval numbers irreproducible across weeks.
# Free-tier availability changes; if you get a 429 with `limit: 0`, the model
# has been retired from the free tier. Run:
#   .venv/Scripts/python -m ingest.main models
GEMINI_VISION_MODEL=gemini-3.5-flash
GEMINI_CHAT_MODEL=gemini-3.5-flash
GEMINI_EMBED_MODEL=gemini-embedding-001

# Locked at 768. Changing this requires re-embedding the whole corpus AND
# altering the vector(768) column in db/001_schema.sql.
EMBED_DIM=768

# Free-tier pacing for the ingest pipeline. Confirm current limits in AI Studio.
GEMINI_RPM=15

# --- Supabase (https://supabase.com) ---
SUPABASE_URL=
# service_role key: ingest scripts + server-side API routes ONLY.
# This key bypasses row-level security — it must never reach the browser.
SUPABASE_SERVICE_KEY=

# --- Next.js public config ---
NEXT_PUBLIC_APP_NAME=Docubo
