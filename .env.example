# Copy to .env (Python ingest) and .env.local (Next.js), then fill in.
# Never commit the filled-in files.

# --- Gemini (https://aistudio.google.com) ---
GEMINI_API_KEY=
GEMINI_VISION_MODEL=gemini-2.0-flash
GEMINI_CHAT_MODEL=gemini-2.0-flash
GEMINI_EMBED_MODEL=gemini-embedding-001

# Locked at 768. Changing this requires re-embedding the whole corpus AND
# altering the vector(768) column in db/001_schema.sql.
EMBED_DIM=768

# Free-tier pacing for the ingest pipeline. Confirm current limits in AI Studio.
GEMINI_RPM=15

# --- Supabase (https://supabase.com) ---
SUPABASE_URL=
# service_role key: ingest scripts + server-side API routes ONLY.
# This key bypasses row-level security — it must never reach the browser.
SUPABASE_SERVICE_KEY=

# --- Next.js public config ---
NEXT_PUBLIC_APP_NAME=Docubo
