# Secrets
.env
.env.local
.env*.local

# Source documents and derived artifacts — never commit (size + copyright).
# `data/*` not `data/`: git cannot un-ignore a file inside an ignored directory,
# so excluding the directory itself would also drop the .gitkeep.
data/*
!data/.gitkeep
eval/reports/*
!eval/reports/.gitkeep

# Python
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
.ruff_cache/
*.egg-info/

# Node / Next.js
node_modules/
.next/
out/
.vercel/
*.tsbuildinfo
# Regenerated by `next build`; committing it just creates merge noise.
next-env.d.ts

# OS / editor
.DS_Store
Thumbs.db
.idea/
.vscode/
